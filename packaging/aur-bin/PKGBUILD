# Maintainer: byindex <tanktez1@gmail.com>
pkgname=omnifetch-bin
pkgver=0.1.0
pkgrel=1
pkgdesc="Extremely fast, modular, zero-overhead Linux system information fetch utility (precompiled binary)"
arch=('x86_64')
url="https://github.com/byindex/omnifetch"
license=('MIT')
provides=('omnifetch')
conflicts=('omnifetch' 'omnifetch-git')
source=("https://github.com/byindex/omnifetch/releases/download/v${pkgver}/omnifetch-v${pkgver}-linux-x86_64.tar.gz")
sha256sums=('224505bc7771e2942d81be9c4a1c044be7e1c292cfd5f9ca19c10addc157f391')

package() {
    cd "${srcdir}/omnifetch-v${pkgver}-linux-x86_64"

    # Install binary
    install -Dm755 omnifetch "${pkgdir}/usr/bin/omnifetch"

    # Install alias wizard
    install -Dm755 setup-aliases.sh "${pkgdir}/usr/share/omnifetch/setup-aliases.sh"

    # Install completions
    install -Dm644 completions/omnifetch.bash "${pkgdir}/usr/share/bash-completion/completions/omnifetch"
    install -Dm644 completions/_omnifetch "${pkgdir}/usr/share/zsh/site-functions/_omnifetch"
    install -Dm644 completions/omnifetch.fish "${pkgdir}/usr/share/fish/vendor_completions.d/omnifetch.fish"

    # Install documentation & license
    install -Dm644 README.md "${pkgdir}/usr/share/doc/omnifetch/README.md"
    install -Dm644 LICENSE "${pkgdir}/usr/share/licenses/omnifetch/LICENSE"
}
